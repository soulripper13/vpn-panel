# =============================================================================
#  VPN Panel — Environment Configuration
#  Copy this file to /opt/vpn-panel/.env and edit the values.
#  The .env file is auto-generated by install.sh with a random SESSION_SECRET.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Port the panel web UI listens on
PANEL_PORT=2096

# Random secret for signing session tokens — CHANGE THIS!
# Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string_here

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/opt/vpn-panel/data/panel.db

# ── sing-box ──────────────────────────────────────────────────────────────────
SINGBOX_BIN=/usr/bin/sing-box
SINGBOX_CONFIG=/etc/sing-box/config.json

# ── xray ─────────────────────────────────────────────────────────────────────
XRAY_BIN=/usr/local/x-ui/bin/xray-linux-amd64
XRAY_CONFIG=/usr/local/x-ui/bin/config.json

# ── TLS Certificates ──────────────────────────────────────────────────────────
# Certificates generated for the server IP
CERT_PATH=/root/cert/ip/fullchain.pem
KEY_PATH=/root/cert/ip/privkey.pem

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug
LOG_LEVEL=info
